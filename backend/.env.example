# Ruta a la clave de cuenta de servicio descargada de Firebase Console (NO la subas a git)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# Región de la tienda: es-co (Colombia) o en-us (Estados Unidos)
PS_STORE_REGION=es-co
# Umbral de descuento para enviar notificación push
MIN_DISCOUNT_FOR_PUSH=50
